# Bedrock API key (console Bedrock > API keys). boto3 reads it directly.
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=eu-central-1
# Model id or inference profile id as shown in the Bedrock console
# Use the inference profile id shown in the console (e.g. global.*) when the model has no in-Region id
BEDROCK_MODEL_ID=global.anthropic.claude-haiku-5-5

# Any SQLAlchemy URL. Empty = bundled SQLite demo DB (read-only).
# Use a READ-ONLY DB user: that's the real security boundary.
# e.g. postgresql+psycopg://readonly:pwd@host:5432/db  (install the driver: uv add psycopg[binary])
DATABASE_URL=

MAX_ROWS=10
AGENT_MAX_STEPS=15
AGENT_TIMEOUT_S=90
